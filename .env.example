# Copy to .env and fill. Never commit .env.

# Strong model: judge + scouts
OPENAI_API_KEY=

# Crowd agents + learning loop (Track 1A requirement)
LUMINAL_API_KEY=
LUMINAL_BASE_URL=          # e.g. https://api.luminal.cloud/v1 (OpenAI-compatible?)
LUMINAL_MODEL=             # e.g. deepseek-v3 / glm-4-flash

# Crowd fallback lane (used if Luminal rate-limits)
GROQ_API_KEY=

# Scout search
TAVILY_API_KEY=

# Mongo Atlas
MONGO_URI=

# Optional overrides
CROWD_MODEL=
JUDGE_MODEL=
SCRAPER_SIDECAR_URL=http://127.0.0.1:8300